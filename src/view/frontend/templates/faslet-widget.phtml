<?php
  /** @var \Magento\Framework\Escaper $escaper */
  /** @var \Magento\Framework\View\Element\Template $block */
  /** @var \Faslet\Connect\ViewModel\ProductWidget $viewModel */

  $viewModel = $block->getViewModel();
?>

<?php if ($widgetData = $viewModel->getWidgetData()): ?>
    <div class="faslet-widget-box">
        <faslet-app
            shop-id="<?= $escaper->escapeHtmlAttr($widgetData['shop']['id'] ?? ''); ?>"
            brand="<?= $escaper->escapeHtmlAttr($widgetData['product']['brand'] ?? ''); ?>"
            product-identifier="<?= $escaper->escapeHtmlAttr($widgetData['product']['id'] ?? ''); ?>"
            product-name="<?= $escaper->escapeHtmlAttr($widgetData['product']['name'] ?? ''); ?>"
            product-img="<?= $escaper->escapeHtmlAttr($widgetData['product']['image'] ?? ''); ?>"
            platform="Magento 2"
        />
    </div>

    <script>
        (() => {
            const productData = {
                size: '',
                color: '',
            }

            window._faslet = {
                id: "<?= $escaper->escapeJs($widgetData['product']['id'] ?? ''); ?>",
                shopUrl: "<?= $escaper->escapeUrl($widgetData['shop']['url'] ?? ''); ?>",
                sku: "<?= $escaper->escapeJs($widgetData['product']['sku'] ?? ''); ?>",
                variants: <?= /* @noEscape */ json_encode($widgetData['product']['variants'] ?? []); ?>,

                addToCart(_) {
                    const form = document.getElementById('product_addtocart_form') || document;
                    const selectOption = (label) => {
                        if (!label) {
                            return;
                        }
                        const value = CSS.escape(label);
                        const option = form.querySelector(`[data-option-label="${value}"], [aria-label="${value}"]`);
                        if (option instanceof HTMLOptionElement) {
                            option.parentElement.value = option.value;
                            option.parentElement.dispatchEvent(new Event('change', {bubbles: true}));
                        } else {
                            option?.click();
                        }
                    };
                    // Hyvä renders qty and the button outside the form, linked via the form attribute
                    const qty = form.elements?.namedItem('qty') || document.querySelector('input[name="qty"]');
                    const addToCart = document.getElementById('product-addtocart-button');

                    selectOption(productData.size);
                    selectOption(productData.color);
                    if (qty) {
                        qty.value = 1;
                    }
                    addToCart?.click();
                },

                onResult(result, _) {
                    productData.size = result.label;
                },

                onColorSelected(colorId) {
                    productData.color = colorId;
                },
            }
        })();
    </script>
    <?php if (isset($hyvaCsp)): ?>
        <?php $hyvaCsp->registerInlineScript() ?>
    <?php endif; ?>
<?php endif; ?>
